{
  "name": "labx-components",
  "version": "1.0.0",
  "description": "Web Components library built with Stencil. Includes Angular wrappers and design tokens.",
  "author": "egarcia9543",
  "license": "MIT",
  "keywords": [
    "stencil",
    "web-components",
    "angular",
    "design-system",
    "labx"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/labx-components/labx-components.esm.js",
  "exports": {
    ".": {
      "import": "./dist/labx-components/labx-components.esm.js",
      "require": "./dist/labx-components/labx-components.cjs.js"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    },
    "./angular": {
      "import": "./dist-angular/components.js",
      "types": "./dist-angular/components.d.ts"
    },
    "./components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./components/*": {
      "import": "./dist/components/*",
      "types": "./dist/components/*"
    }
  },
  "files": [
    "dist/",
    "loader/",
    "src-angular/",
    "dist-angular/"
  ],
  "scripts": {
    "build": "node -e \"require('fs').mkdirSync('dist-angular',{recursive:true})\" && stencil build && node scripts/patch-angular.js && tsc -p tsconfig.angular.json",
    "build:angular": "node scripts/patch-angular.js && tsc -p tsconfig.angular.json",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil-test",
    "test:watch": "stencil-test --watch",
    "generate": "stencil generate"
  },
  "devDependencies": {
    "@angular/core": "^18.2.14",
    "@angular/forms": "^18.2.14",
    "@stencil/angular-output-target": "^1.3.0",
    "@stencil/core": "^4.27.1",
    "@stencil/vitest": "^1.8.3",
    "@types/node": "^22.13.5",
    "@vitest/browser-playwright": "^4.0.0",
    "rxjs": "^7.8.2",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "@stencil/core": "^4.0.0"
  }
}
